# ══════════════════════════════════════════════════════════════
#  env.sample — project configuration template
#
#  Usage:   cp env.sample .env   then fill in the values
#  ⚠️  .env contains secrets: NEVER commit it.
#  Variables marked [REQUIRED] block the relevant command
#  if they are empty or still « your_… » (see `make env-check`).
# ══════════════════════════════════════════════════════════════

# ── Légifrance API / PISTE — https://piste.gouv.fr ───────────
# [REQUIRED] for `make ingest` / `make all`.
# PISTE account → application « Légifrance » → client credentials.
# As long as these two values are placeholders, ingestion stops
# immediately (make env-check-legifrance / run.py --step ingest).
LEGIFRANCE_CLIENT_ID=your_client_id_here
LEGIFRANCE_CLIENT_SECRET=your_client_secret_here
# API environment: sandbox (default) or production
# LEGIFRANCE_ENV=production

# ── Qdrant (vector database) ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=code_civil

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# ── Article chunking ────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── llama.cpp (local OpenAI-compatible server) ──────────────
LLAMACPP_BASE_URL=http://127.0.0.1:12080/v1

# ── llama.cpp engine: docker (recommended) or local (build) ──
# docker: uses a pinned ghcr.io/ggml-org/llama.cpp image, NO
#          compilation on the host; the CUDA runtime is included in the image.
# local : builds llama.cpp in llama.cpp/build (historical fallback).
# Digest pinning for reproducibility (recommended), e.g.:
#   ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:<digest>
# CUDA 13 variants: rolling tags server-cuda13 / full-cuda13 (pin those too).
LLAMA_BACKEND=docker
# Digests validated here (the versioned b47xx tags are TOO OLD: the
# converter does not know the qwen3_5 architecture of Qwen3.8).
# To refresh: docker pull <tag> then copy the displayed digest.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:d154fba060de774527c436ffecf74a64444874bfae2ad57b4be8faa7c52fb40c
LLAMA_CPP_TOOLS_IMAGE=ghcr.io/ggml-org/llama.cpp:full-cuda@sha256:1a4983fc58a092dc0a63e13d07213f58ffbcf454143f0a433b25bcfe4d109f06
LLAMA_CONTAINER_NAME=code-civil-llama

# Model used to generate the Q/A dataset (step 2)
DATASET_GEN_MODEL=Qwen3.8-27B-UD-IQ3_S.gguf
# Model used for RAG inference (Streamlit interface)
RAG_INFERENCE_MODEL=Qwen3.8-27B-UD-IQ3_S.gguf

# ── LLM backend: OpenAI-compatible external API (optional) ──
# If LLM_API_BASE_URL, LLM_API_KEY and LLM_MODEL are set, the external
# API is used instead of llama.cpp. Otherwise, the local model is used.
LLM_BACKEND=auto              # auto | external | local
LLM_API_BASE_URL=             # e.g. https://api.openai.com/v1
LLM_API_KEY=                  # API key — never commit .env
LLM_MODEL=                    # e.g. gpt-4o-mini (required if external backend)
LLM_TIMEOUT=600
LLM_MAX_RETRIES=2
LLM_PARALLEL=4                # simultaneous calls (dataset / RAG batch)
LLM_THINKING_KWARG=auto       # auto | on | off
# LLM_MAX_TOKENS_PARAM=max_tokens  # or max_completion_tokens
# DATASET_WORKERS=4            # dataset override only (optional)

# ── Fine-tuning (Unsloth + QLoRA) ────────────────────────────
# 4B recommended for 16 GB of VRAM; 9B possible but slower.
BASE_MODEL=./models/Qwen3.8-9B-Distill
# BASE_MODEL=./models/Qwen3.8-4B-Distill   # faster, lower quality
FINETUNED_MODEL_PATH=./finetuning/output/qwen38-9b-code-civil

# [OPTIONAL] HuggingFace token.
# Public models (e.g. unsloth/Qwen3.8-27B-GGUF): not needed, leave empty.
# Only required for private/gated models or `--push-hub`.
HF_TOKEN=

# ── Automatic provisioning (used by `make all`) ────────────
# These values are Makefile defaults; uncomment to change them.
# MODEL_GGUF_REPO=unsloth/Qwen3.8-27B-GGUF
# MODEL_GGUF_FILE=Qwen3.8-27B-UD-IQ3_S.gguf
# BASE_MODEL_REPO=empero-ai/Qwen3.8-9B-Distill
# CACHE_SOURCE=auto     # auto | api | dump
#   auto: PISTE API if LEGIFRANCE_CLIENT_ID is set, otherwise offline LEGI dump
#   dump: forces download of the LEGI dump (~1.2 GB) + extraction (~27 GB)
#   api : forces the PISTE API call (~1 h, requires the keys)

# ── Dataset ──────────────────────────────────────────────────
# Number of Q/A pairs generated by `make dataset` (0 = all tasks).
# Full dataset = 0: 5,809 articles × 5 templates = 29,045 tasks (~55 h of generation
# with the 27B on a 3080 Ti; see also `make dataset-resume`).
DATASET_SIZE=0
DATASET_PATH=./dataset/code_civil_qa.jsonl
